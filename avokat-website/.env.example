# ------------------------------------------------------------------
# Variablat e mjedisit. Kopjojeni si .env (lokalisht) ose vendosini te
# paneli i hostimit. MOS i ruani vlerat reale në Git.
# ------------------------------------------------------------------

# --- Build ---
# Domeni kanonik (pa / në fund). Parazgjedhja në kod: https://gegaattorney.al
SITE_URL=https://gegaattorney.al
# Lejoni indeksimin nga motorët e kërkimit VETËM pasi të jetë miratuar përmbajtja.
# Pa këtë, faqja ka noindex dhe robots.txt bllokon gjithçka.
ALLOW_INDEXING=false

# --- Runtime ---
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Sekret i rastësishëm (min. 32 karaktere) për nënshkrimin e formularëve.
# Gjenerojeni me: openssl rand -hex 32
FORM_SECRET=

# Dërgimi i emaileve: "smtp" (prodhim). "log" vetëm për testim lokal.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gentjangega.lawoffice@gmail.com
# Për Gmail: "App Password" (kërkon verifikimin me dy hapa), JO fjalëkalimi i zakonshëm.
SMTP_PASS=
# Dërguesi duhet të jetë adresa e llogarisë SMTP (ose një alias i verifikuar).
MAIL_FROM="Faqja e internetit <gentjangega.lawoffice@gmail.com>"
# Ku mbërrijnë mesazhet dhe kërkesat për takim.
MAIL_TO=gentjangega.lawoffice@gmail.com
