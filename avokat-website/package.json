{
  "name": "avokat-website",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./server.mjs",
    "check": "astro check",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/unit/*.test.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "audit:placeholders": "node scripts/audit-placeholders.mjs",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "images": "node --experimental-strip-types --no-warnings scripts/generate-images.mjs",
    "build:preview": "SITE_URL=https://orgestlikaj.github.io BASE_PATH=/portfolio/gega-preview PUBLIC_PREVIEW=true astro build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "astro": "7.3.8",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^6.0.3"
  }
}
