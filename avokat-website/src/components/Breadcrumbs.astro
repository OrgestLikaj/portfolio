---
import type { Crumb } from '../lib/seo.ts';
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav aria-label="Gjurma e navigimit" class="crumbs">
  <ol>
    {
      items.map((c, i) => (
        <li>
          {i < items.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex; flex-wrap: wrap; gap: 6px 0;
    list-style: none; margin: 0 0 28px; padding: 0;
    font-size: 0.82rem; letter-spacing: 0.04em;
    color: rgba(246, 242, 234, 0.65);
  }
  .crumbs li:not(:last-child)::after { content: '/'; margin-inline: 10px; opacity: 0.5; }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: var(--bronze-light); }
  .crumbs [aria-current] { color: var(--ivory); }
</style>
